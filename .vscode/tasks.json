{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build WearTAK Garmin",
            "type": "shell",
            "command": "${env:CONNECTIQ_SDK}\\bin\\monkeyc.bat",
            "args": [
                "-o",
                "${workspaceFolder}\\WearTAK-Garmin.iq",
                "-f",
                "${workspaceFolder}\\monkey.jungle",
                "-y",
                "${config:monkeyC.developerKeyPath}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}